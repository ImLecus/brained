{
  "name": "brained",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "start": "tsx server/index.ts",
    "build": "npm run typecheck && vite build",
    "build:server": "tsc -p tsconfig.server.build.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "electron": "electron .",
    "electron:pack": "npm run build && npm run build:server && electron-builder --dir",
    "electron:dist": "npm run build && npm run build:server && electron-builder"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@opencode-ai/sdk": "^1.18.30",
    "d3-force": "^3.0.0",
    "fast-glob": "^3.3.3",
    "fastify": "^5.12.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-force-graph-2d": "^1.29.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "app.brained.desktop",
    "productName": "Brained",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "dist-server/**",
      "config.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
